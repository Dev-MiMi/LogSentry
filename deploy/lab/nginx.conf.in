user www-data;
worker_processes 1;
pid /run/logsentry-proxy/nginx.pid;
error_log /var/log/nginx/logsentry-error.log warn;
events { worker_connections 128; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/logsentry-access.log;
    sendfile on;
    keepalive_timeout 15;
    limit_req_zone $binary_remote_addr zone=logsentry_login:1m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=logsentry_api:1m rate=10r/s;
    limit_req_status 429;
    server {
        listen 127.0.0.1:8444 ssl;
        server_name 127.0.0.1 localhost;
        ssl_certificate /etc/logsentry-lab/tls/server.pem;
        ssl_certificate_key /etc/logsentry-lab/tls/server-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 256k;
        client_body_timeout 15s;
        add_header X-Content-Type-Options nosniff always;
        location /static/ { alias /var/lib/logsentry-lab-static/; }
        location = /accounts/login/ {
            limit_req zone=logsentry_login burst=5 nodelay;
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
        location /api/ {
            limit_req zone=logsentry_api burst=20 nodelay;
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 30s;
        }
        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
    }
}
