[Unit]
Description=LogSentry local registered file collection
PartOf=logsentry-lab.target
After=network.target

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python -u -m logsentry.collector --database @ROOT@/runtime/collection.sqlite3 --watch --interval 2
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@ROOT@/runtime
