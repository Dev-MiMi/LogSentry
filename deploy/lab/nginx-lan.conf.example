# Include inside the existing lab's http {} block after replacing the IP/subnet.
# Expose only collector endpoints; browser administration stays on loopback.
server {
    listen 192.168.139.101:8444 ssl;
    server_name 192.168.139.101;
    ssl_certificate /etc/logsentry-lab/tls/lan-server.pem;
    ssl_certificate_key /etc/logsentry-lab/tls/lan-server-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    client_body_timeout 15s;
    add_header X-Content-Type-Options nosniff always;
    allow 192.168.139.0/24;
    deny all;

    location = /api/v1/events/ {
        limit_except POST { deny all; }
        limit_req zone=logsentry_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
    location = /api/v1/heartbeat/ {
        limit_except POST { deny all; }
        limit_req zone=logsentry_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
    location / { deny all; }
}
