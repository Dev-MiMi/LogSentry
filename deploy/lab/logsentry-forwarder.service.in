[Unit]
Description=LogSentry queued delivery to local HTTPS receiver
PartOf=logsentry-lab.target
After=logsentry-web.service logsentry-proxy.service

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@
EnvironmentFile=/etc/logsentry-lab/web.env
ExecStart=@ROOT@/.venv/bin/python manage.py forward_events --watch
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@ROOT@/runtime
