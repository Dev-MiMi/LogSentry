[Unit]
Description=LogSentry JSON event export for Wazuh
After=network.target

[Service]
User=logsentry
Group=logsentry
WorkingDirectory=/opt/logsentry
Environment=LOGSENTRY_RUNTIME_DIR=/var/lib/logsentry
ExecStart=/opt/logsentry/.venv/bin/python manage.py export_wazuh --watch
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/logsentry

[Install]
WantedBy=multi-user.target
