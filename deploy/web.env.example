# Replace the hostname/IP with the one you will use in your browser/certificate.
LOGSENTRY_DEBUG=0
LOGSENTRY_ALLOWED_HOSTS=logsentry.example.com
LOGSENTRY_RUNTIME_DIR=/var/lib/logsentry
# Nginx overwrites this header and Gunicorn is reachable only on loopback.
LOGSENTRY_TRUST_PROXY=1
# init_web creates the private persistent secret key in the runtime directory.
